/**
 * @fileoverview Firestore Security Rules for Video Grabber application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Users can only access their own profile data and the video downloads associated with their account.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /users/{userId}/videoDownloads/{downloadId}: Stores individual video download entries for a user.
 * - /users/{userId}/subscriptions/{subscriptionId}: Stores subscription information for a user.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own user documents and associated data.
 * - Listing all users is disallowed.
 *
 * Denormalization for Authorization:
 *  -  The `userId` is present both in the path and as a field in the documents, which simplifies authorization checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 can create their own profile.
     * @allow (get) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 can read their own profile.
     * @allow (update) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 can update their own profile.
     * @allow (delete) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 can delete their own profile.
     * @deny (create) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 cannot create a profile with a mismatched userId.
     * @deny (get) User AnotherUser cannot read User LbdiH8HR0bakYw0FQyeyrGfpAjw2's profile.
     * @deny (update) User AnotherUser cannot update User LbdiH8HR0bakYw0FQyeyrGfpAjw2's profile.
     * @deny (delete) User AnotherUser cannot delete User LbdiH8HR0bakYw0FQyeyrGfpAjw2's profile.
     * @principle Enforces user-ownership; only the user can manage their own profile.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to video download entries for each user.
     * @path /users/{userId}/videoDownloads/{downloadId}
     * @allow (create) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 can create a download entry in their own profile.
     * @allow (get) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 can read a download entry in their own profile.
     * @allow (update) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 can update a download entry in their own profile.
     * @allow (delete) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 can delete a download entry in their own profile.
     * @deny (create) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 cannot create a download entry with a mismatched userId.
     * @deny (get) User AnotherUser cannot read User LbdiH8HR0bakYw0FQyeyrGfpAjw2's download entries.
     * @deny (update) User AnotherUser cannot update User LbdiH8HR0bakYw0FQyeyrGfpAjw2's download entries.
     * @deny (delete) User AnotherUser cannot delete User LbdiH8HR0bakYw0FQyeyrGfpAjw2's download entries.
     * @principle Enforces user-ownership; only the user can manage their own video download entries.
     */
    match /users/{userId}/videoDownloads/{downloadId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
    
        /**
     * @description Controls access to subscription status for each user.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (get) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 can read their subscription status.
     * @allow (create) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 can create their subscription status.
     * @allow (update) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 can update their subscription status.
     * @allow (delete) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 can delete their subscription status.
     * @deny (get) User AnotherUser cannot read User LbdiH8HR0bakYw0FQyeyrGfpAjw2's subscription status.
     * @deny (create) User LbdiH8HR0bakYw0FQyeyrGfpAjw2 cannot create a subscription status with a mismatched userId.
     * @deny (update) User AnotherUser cannot update User LbdiH8HR0bakYw0FQyeyrGfpAjw2's subscription status.
     * @deny (delete) User AnotherUser cannot delete User LbdiH8HR0bakYw0FQyeyrGfpAjw2's subscription status.
     * @principle Enforces user-ownership; only the user can manage their own subscription status.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}

/**
 * @description Checks if the current user is signed in.
 * @return {boolean} True if the user is signed in, false otherwise.
 */
function isSignedIn() {
  return request.auth != null;
}

/**
 * @description Checks if the current user is the owner of the resource.
 * @param {string} userId The user ID to compare against the authenticated user's ID.
 * @return {boolean} True if the user is the owner, false otherwise.
 */
function isOwner(userId) {
  return isSignedIn() && request.auth.uid == userId;
}

/**
 * @description Checks if the current user is the owner of the resource and the resource exists.
 * @param {string} userId The user ID to compare against the authenticated user's ID.
 * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
 */
function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
}