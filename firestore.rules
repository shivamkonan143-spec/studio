/**
 * @file Firestore Security Rules for Video Grabber App
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model, ensuring that only authenticated users can access their own data.
 *
 * @data_structure All user data is nested under the /users/{userId} collection. Video download data is stored in a subcollection /users/{userId}/videoDownloads/{downloadId}.
 *
 * @key_security_decisions
 *   - Users can only access their own user document.
 *   - Users can only access video downloads associated with their user ID.
 *   - Data validation is relaxed to allow for rapid prototyping and flexible data shapes. Only authorization-critical fields are validated.
 *   - Listing of all users is disallowed. Listing of video downloads is allowed only for the owner.
 *   - All write operations require the user to be authenticated.
 *   - `update` and `delete` operations additionally require the target document to exist.
 *
 * @denormalization_for_authorization The `videoDownloads` documents contain the `userId` of their owner. This avoids needing to perform expensive `get()` operations to check ownership of a download.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the user profile document.
     * @path /users/{userId}
     * @allow (create) Authenticated user can create their own profile if the userId matches their auth UID.
     * @allow (get, update, delete) Authenticated user can get, update, and delete their own profile if the userId matches their auth UID and the document exists.
     * @deny (create, get, update, delete) Any operation where the userId does not match the auth UID, or the document does not exist for updates/deletes.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // isOwner function checks if the requested userId matches the authenticated user's id
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // isExistingOwner checks that user ID matches the authenticated user AND that the document exists.
      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      // isSignedIn function checks if a user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isExistingOwner(userId);
      allow list: if false; // Do not allow listing all users

      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures video download documents for each user.
     * @path /users/{userId}/videoDownloads/{downloadId}
     * @allow (create, get, list, update, delete) Authenticated user can create, get, list, update, and delete their own video downloads.
     * @deny (create, get, list, update, delete) Any operation where the userId does not match the auth UID, or the document does not exist for updates/deletes.
     * @principle Enforces document ownership for all operations within the user's data tree.
     */
    match /users/{userId}/videoDownloads/{downloadId} {
       // isOwner function checks if the requested userId matches the authenticated user's id
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // isExistingOwner checks that user ID matches the authenticated user AND that the document exists.
      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      // isSignedIn function checks if a user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}